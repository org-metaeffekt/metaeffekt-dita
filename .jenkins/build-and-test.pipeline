pipeline {
    agent {
        label 'metaeffekt-astronaut'
    }

    tools {
        jdk 'ZULU17'
        maven 'MAVEN3912'
    }

    environment {
        MAVEN_REPO = "$WORKSPACE/.m2/repository"
    }

    stages {
        stage('Pull repository from server') {
            steps {
                sh 'wget -r -np -nH --cut-dirs=3 -R "index.html*" http://ae-scanner/repository/org/dita-ot/'
            }
        }

        stage('Prepare Maven repository folder') {
            steps {
                sh 'mkdir -p $MAVEN_REPO/org'
                sh 'rm -rf $MAVEN_REPO/org/dita-ot/*'
            }
        }

        stage('Move repository to Maven repository folder') {
            steps {
                sh 'mv dita-ot $MAVEN_REPO/org/dita-ot'
            }
        }

        stage('Checkout metaeffekt-core') {
            steps {
                script {
                    sh 'mkdir -p .metaeffekt-core'
                    dir ('.metaeffekt-core') {
                        withCredentials([usernamePassword(credentialsId: 'JenkinsGithubAccess', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
                            git url: 'https://github.com/org-metaeffekt/metaeffekt-core.git', branch: 'master', credentialsId: 'JenkinsGithubAccess'
                        }
                    }
                }
            }
        }

        stage('Build metaeffekt-core (skipping tests and javadoc)') {
            steps {
                dir ('.metaeffekt-core') {
                    withMaven(maven: 'MAVEN3912', mavenLocalRepo: '$MAVEN_REPO') {
                        sh 'mvn -B clean install -DskipTests -Dmaven.javadoc.skip=true'
                    }
                }
            }
        }

        stage('Build') {
            steps {
                sh 'rm -rf /tmp/dita'
                sh 'rm -rf /tmp/dita-customization'
                sh 'mkdir -p /tmp/dita-customization'

                withMaven(maven: 'MAVEN3912', mavenLocalRepo: '$MAVEN_REPO') {
                    sh 'mvn -B clean install -Ddita.customization.basedir=/tmp/dita-customization'
                }
            }
        }
    }
}
